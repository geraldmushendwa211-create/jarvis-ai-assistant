# Copy this file to .env and fill in your key:
#   cp .env.example .env   (Linux/macOS)  |  copy .env.example .env   (Windows)

# Required — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Optional — swap the Gemini model without touching code
GEMINI_MODEL=gemini-3.5-flash

# Optional local voice backend. Keep "edge" until the separate Kokoro environment is ready.
# JARVIS_TTS_ENGINE=edge
# JARVIS_TTS_SPEED=0.98
# JARVIS_TTS_VOICE=en-GB-RyanNeural
# KOKORO_VOICE=bm_george

# Optional — override automatic physical-microphone selection with a device index or name.
# JARVIS_MIC_DEVICE=2

